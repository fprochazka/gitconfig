#!/usr/bin/env bash
#
# git-worktree-cleanup - Interactively remove git worktrees
#
# Usage: git worktree-cleanup
#
# Lists all worktrees (excluding the main repository directory) with rich
# branch information, then prompts for selection to remove.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/common.sh"

show_help() {
    cat << 'EOF'
Usage: git worktree-cleanup [-i|--interactive] [-l|--list] [--no-signals]

Interactively remove git worktrees.

When run from within a worktree, offers to clean up that worktree directly.
When run from the main repository (or with -i), displays a numbered list
of all worktrees with branch information including:
  - Branch name
  - Commit hash
  - Upstream tracking status (ahead/behind)
  - Last commit message

Each worktree also shows whether it may still be needed:
  - keep: unversioned files worth keeping (untracked or ignored files that are
    not build output, IDE state, or an identical copy of the main repo's file;
    fifos, sockets and empty directories are never kept)
  - sessions: Claude Code sessions started in the worktree directory

Options:
    -i, --interactive   Force interactive selection even when in a worktree
    -l, --list          Only print the list and exit (read-only: no prune, no prompts)
    --no-signals        Skip the keep/sessions scan (faster on hundreds of worktrees)

Examples:
    git worktree-cleanup        # Clean current worktree, or list if in main repo
    git worktree-cleanup -i     # Always show interactive list
    git worktree-cleanup -l     # Just print the list
EOF
}

# Get formatted branch info for a worktree
# Usage: get_worktree_branch_info <branch_name>
get_worktree_branch_info() {
    local branch="$1"
    local commit_hash
    local commit_msg
    local upstream_info=""

    # Get short commit hash
    commit_hash=$(git rev-parse --short "$branch" 2>/dev/null || echo "??????")

    # Get first line of commit message (truncated to 60 chars)
    commit_msg=$(git log -1 --format='%s' "$branch" 2>/dev/null || echo "")
    commit_msg="${commit_msg:0:60}"

    # Get upstream tracking info
    local upstream
    if upstream=$(git rev-parse --abbrev-ref "${branch}@{upstream}" 2>/dev/null); then
        local ahead behind
        ahead=$(git rev-list --count "${upstream}..${branch}" 2>/dev/null || echo 0)
        behind=$(git rev-list --count "${branch}..${upstream}" 2>/dev/null || echo 0)

        if [[ "$ahead" -gt 0 ]] && [[ "$behind" -gt 0 ]]; then
            upstream_info="${COLOR_YELLOW}[${upstream}: ahead ${ahead}, behind ${behind}]${COLOR_RESET}"
        elif [[ "$ahead" -gt 0 ]]; then
            upstream_info="${COLOR_GREEN}[${upstream}: ahead ${ahead}]${COLOR_RESET}"
        elif [[ "$behind" -gt 0 ]]; then
            upstream_info="${COLOR_RED}[${upstream}: behind ${behind}]${COLOR_RESET}"
        else
            upstream_info="[${upstream}]"
        fi
    fi

    echo -e "${COLOR_GREEN}${branch}${COLOR_RESET} ${commit_hash} ${upstream_info} ${commit_msg}"
}

# Compute keeper-file summaries for many worktrees in parallel (one git scan each)
# Output lines: "<path>\t<keeper_count>\t<newest_mtime_epoch>\t<discarded_count>"
# Usage: compute_keeper_summaries <main_repo_root> <worktree_path>...
compute_keeper_summaries() {
    local main_root="$1"
    shift
    [[ $# -gt 0 ]] || return 0

    # shellcheck disable=SC2016 # expanded by the inner bash
    local worker='source "$1"; read -r count newest discarded < <(worktree_keeper_summary "$3" "$2"); printf "%s\t%s\t%s\t%s\n" "$3" "$count" "$newest" "$discarded"'
    printf '%s\0' "$@" \
        | xargs -0 -r -n 1 -P "$(nproc 2>/dev/null || echo 4)" bash -c "$worker" _ "${SCRIPT_DIR}/lib/common.sh" "$main_root"
}

# Format the "do I still need this" signals of a worktree
# Usage: format_worktree_signals <keeper_count> <keeper_newest> <session_count> <session_newest>
format_worktree_signals() {
    local keep_count="$1" keep_newest="$2" session_count="$3" session_newest="$4" discarded_count="${5:-0}"
    local keep sessions

    if [[ "$keep_count" == "?" ]]; then
        keep="${COLOR_RED}keep: ? (could not list all unversioned files)${COLOR_RESET}"
    elif [[ "$keep_count" -gt 0 ]]; then
        keep="${COLOR_YELLOW}keep: ${keep_count} files, newest $(date -d "@${keep_newest}" +%F)${COLOR_RESET}"
    elif [[ "$discarded_count" -gt 0 ]]; then
        keep="${COLOR_DIM}nothing to keep, ${discarded_count} build/IDE/copied entries${COLOR_RESET}"
    else
        keep="${COLOR_DIM}no unversioned files${COLOR_RESET}"
    fi

    if [[ "$session_count" -gt 0 ]]; then
        sessions="sessions: ${session_count}, last $(date -d "@${session_newest}" +%F)"
    else
        sessions="${COLOR_DIM}no sessions${COLOR_RESET}"
    fi

    echo -e "${keep} ${COLOR_DIM}·${COLOR_RESET} ${sessions}"
}

# Remove a worktree and optionally its branch
# Usage: remove_worktree <path> <branch>
remove_worktree() {
    local selected_path="$1"
    local selected_branch="$2"

    print_yellow "Removing worktree: $selected_path"

    # Remove the worktree, offering --force if it has modifications
    if ! git worktree remove "$selected_path" 2>/dev/null; then
        warn "Worktree contains modified or untracked files."
        echo -n "Force remove? [y/N]: "
        local confirm=""
        read -r confirm || true
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            git worktree remove --force "$selected_path"
        else
            die "Aborted."
        fi
    fi

    print_green "Worktree removed successfully."

    # Drop the worktree's Claude Code per-directory project entry
    remove_claude_project_entry "$selected_path"

    # Optionally delete the branch if it exists
    if [[ "$selected_branch" != "detached" ]]; then
        local main_branch
        main_branch=$(get_main_branch)

        # Check if branch is merged into main
        if is_branch_merged "$selected_branch" "$main_branch"; then
            # Auto-delete merged branches
            git branch -d "$selected_branch"
            print_green "Branch '$selected_branch' deleted (was merged into $main_branch)."
        else
            # Ask for unmerged branches
            echo ""
            echo -n "Also delete unmerged branch '$selected_branch'? [y/N]: "
            read -r delete_branch
            if [[ "$delete_branch" =~ ^[Yy]$ ]]; then
                git branch -D "$selected_branch"
                print_green "Branch '$selected_branch' deleted."
            fi
        fi
    fi
}

# Find and remove orphaned directories in the worktrees directory
# These are leftover dirs that git worktree no longer tracks
# Checks both legacy (<project>-worktrees) and new (<project>/.worktrees) locations
# Usage: cleanup_orphaned_dirs <main_worktree_path>
cleanup_orphaned_dirs() {
    local main_worktree="$1"
    local legacy_dir new_dir
    legacy_dir=$(get_legacy_worktrees_dir "$main_worktree")
    new_dir="${main_worktree}/.worktrees"

    # Collect all worktrees dirs that exist
    local -a worktrees_dirs=()
    [[ -d "$legacy_dir" ]] && worktrees_dirs+=("$legacy_dir")
    [[ -d "$new_dir" ]] && worktrees_dirs+=("$new_dir")

    # No worktrees directories - nothing to clean
    [[ ${#worktrees_dirs[@]} -gt 0 ]] || return 0

    # Collect known worktree paths from git
    local -a known_paths=()
    while IFS= read -r line; do
        if [[ "$line" =~ ^worktree\ (.+)$ ]]; then
            known_paths+=("${BASH_REMATCH[1]}")
        fi
    done < <(git worktree list --porcelain)

    # Check each directory in all worktrees dirs
    local -a orphaned=()
    local dir wt_dir
    for wt_dir in "${worktrees_dirs[@]}"; do
    for dir in "$wt_dir"/*/; do
        [[ -d "$dir" ]] || continue
        dir="${dir%/}"  # strip trailing slash

        local is_known=false
        local known
        for known in "${known_paths[@]}"; do
            if [[ "$dir" == "$known" ]]; then
                is_known=true
                break
            fi
        done

        if [[ "$is_known" == false ]]; then
            orphaned+=("$dir")
        fi
    done
    done

    [[ ${#orphaned[@]} -gt 0 ]] || return 0

    print_yellow "Found ${#orphaned[@]} orphaned worktree directories (not tracked by git):"
    echo ""
    for dir in "${orphaned[@]}"; do
        echo "  $(basename "$dir")/"
    done
    echo ""
    echo -n "Remove all orphaned directories? [y/N]: "
    local confirm=""
    read -r confirm || true

    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        for dir in "${orphaned[@]}"; do
            rm -rf "$dir"
            remove_claude_project_entry "$dir"
            print_green "Removed: $(basename "$dir")/"
        done
        echo ""
    fi
}

main() {
    local force_interactive=false
    local list_only=false
    local show_signals=true

    # Handle flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_help
                exit 0
                ;;
            --interactive|-i)
                force_interactive=true
                shift
                ;;
            --list|-l)
                list_only=true
                shift
                ;;
            --no-signals)
                show_signals=false
                shift
                ;;
            *)
                die "Unknown option: $1"
                ;;
        esac
    done

    require_git_repo

    local main_worktree
    main_worktree=$(get_main_repo_root)

    # --list is strictly read-only: no pruning, no orphan cleanup, no prompts
    if [[ "$list_only" == false ]]; then
        # Prune stale worktree references (e.g. manually deleted directories)
        git worktree prune

        # Clean up orphaned worktree directories (not tracked by git worktree list)
        cleanup_orphaned_dirs "$main_worktree"
    fi

    local current_worktree
    current_worktree=$(git rev-parse --show-toplevel)

    # If we're in a worktree (not main repo) and not forcing interactive mode,
    # offer to clean up the current worktree directly
    if [[ "$current_worktree" != "$main_worktree" ]] && [[ "$force_interactive" == false ]] && [[ "$list_only" == false ]]; then
        local current_branch
        current_branch=$(get_current_branch)

        echo ""
        local info
        if [[ "$current_branch" != "HEAD" ]]; then
            info=$(get_worktree_branch_info "$current_branch")
        else
            info="${COLOR_YELLOW}(detached HEAD)${COLOR_RESET}"
            current_branch="detached"
        fi

        echo -e "Current worktree: $info"
        echo -e "  ${COLOR_BOLD}${current_worktree}${COLOR_RESET}"
        echo ""
        echo -n "Remove this worktree? [Y/n]: "
        read -r confirm

        if [[ ! "$confirm" =~ ^[Nn]$ ]]; then
            echo ""
            remove_worktree "$current_worktree" "$current_branch"
        fi
        exit 0
    fi

    # Collect worktrees (excluding main)
    local -a worktree_paths=()
    local -a worktree_branches=()

    local current_path=""
    local skip_current=false

    while IFS= read -r line; do
        # Parse worktree list --porcelain output
        if [[ "$line" =~ ^worktree\ (.+)$ ]]; then
            current_path="${BASH_REMATCH[1]}"
            # Skip main worktree
            if [[ "$current_path" == "$main_worktree" ]]; then
                skip_current=true
            else
                skip_current=false
                worktree_paths+=("$current_path")
            fi
        elif [[ "$line" =~ ^branch\ refs/heads/(.+)$ ]]; then
            if [[ "$skip_current" == false ]]; then
                local branch="${BASH_REMATCH[1]}"
                worktree_branches+=("$branch")
            fi
        elif [[ "$line" =~ ^HEAD\ [0-9a-f]+$ ]] && [[ "$skip_current" == false ]] && [[ -z "${worktree_branches[${#worktree_paths[@]}-1]:-}" ]]; then
            # Detached HEAD - no branch line will follow, add placeholder
            :
        elif [[ -z "$line" ]]; then
            # Empty line separates worktree entries
            # If we added a path but no branch yet, it's detached
            if [[ "$skip_current" == false ]] && [[ ${#worktree_paths[@]} -gt ${#worktree_branches[@]} ]]; then
                worktree_branches+=("detached")
            fi
        fi
    done < <(git worktree list --porcelain)

    # Handle last entry if no trailing newline
    if [[ ${#worktree_paths[@]} -gt ${#worktree_branches[@]} ]]; then
        worktree_branches+=("detached")
    fi

    # Check if we have any worktrees to clean up
    if [[ ${#worktree_paths[@]} -eq 0 ]]; then
        echo "No worktrees to clean up (only the main repository exists)."
        exit 0
    fi

    # Precompute mainline commits for bulk merged-with-changes detection
    local main_branch
    main_branch=$(get_main_branch)
    _mainline_file=$(mktemp)
    get_mainline_commits "$main_branch" > "$_mainline_file"
    trap 'rm -f "$_mainline_file" "${_session_index_file:-}"' EXIT

    # Signals: unversioned keeper files (scanned in parallel) and Claude sessions per path
    local -A keep_counts=() keep_newest=() keep_discarded=()
    if [[ "$show_signals" == true ]]; then
        _session_index_file=$(mktemp)
        build_claude_session_index > "$_session_index_file"
        local summary_path summary_count summary_newest summary_discarded
        while IFS=$'\t' read -r summary_path summary_count summary_newest summary_discarded; do
            keep_counts["$summary_path"]="$summary_count"
            keep_newest["$summary_path"]="$summary_newest"
            keep_discarded["$summary_path"]="$summary_discarded"
        done < <(compute_keeper_summaries "$main_worktree" "${worktree_paths[@]}")
    fi

    # Build display list
    echo ""
    print_bold "Worktrees:"
    echo ""

    for i in "${!worktree_paths[@]}"; do
        local path="${worktree_paths[$i]}"
        local branch="${worktree_branches[$i]:-detached}"
        local num=$((i + 1))

        local status_tag=""
        if [[ "$branch" != "detached" ]]; then
            if is_branch_merged_with_changes "$branch" "$main_branch" "$_mainline_file"; then
                status_tag="${COLOR_PURPLE}[merged]${COLOR_RESET} "
            elif is_branch_no_changes "$branch" "$main_branch"; then
                status_tag="${COLOR_PURPLE}[no changes]${COLOR_RESET} "
            fi
        fi

        local info
        if [[ "$branch" != "detached" ]]; then
            info=$(get_worktree_branch_info "$branch")
        else
            info="${COLOR_YELLOW}(detached HEAD)${COLOR_RESET}"
        fi

        printf "  %2d) %b%s\n" "$num" "$status_tag" "$info"
        printf "      ${COLOR_BOLD}%s${COLOR_RESET}\n" "$path"
        if [[ "$show_signals" == true ]]; then
            local session_count session_newest
            read -r session_count session_newest < <(claude_sessions_for_path "$_session_index_file" "$path")
            printf "      %s\n" "$(format_worktree_signals "${keep_counts[$path]:-?}" "${keep_newest[$path]:-0}" "$session_count" "$session_newest" "${keep_discarded[$path]:-0}")"
        fi
        echo ""
    done

    [[ "$list_only" == false ]] || exit 0

    # Prompt for selection
    local selection
    echo -n "Enter number to remove (Ctrl+C to cancel): "
    read -r selection

    # Validate selection
    if ! [[ "$selection" =~ ^[0-9]+$ ]]; then
        die "Invalid selection: $selection"
    fi

    local index=$((selection - 1))
    if [[ $index -lt 0 ]] || [[ $index -ge ${#worktree_paths[@]} ]]; then
        die "Selection out of range: $selection"
    fi

    local selected_path="${worktree_paths[$index]}"
    local selected_branch="${worktree_branches[$index]:-detached}"

    echo ""
    remove_worktree "$selected_path" "$selected_branch"
}

main "$@"
