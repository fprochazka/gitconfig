#!/usr/bin/env bash
#
# git-worktree-cleanup - Interactively remove git worktrees
#
# Usage: git worktree-cleanup
#
# Lists all worktrees (excluding the main repository directory) with rich
# branch information, then prompts for selection to remove.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/common.sh"
source "${SCRIPT_DIR}/lib/vcs-hosting.sh"

# Run as a git alias from inside a worktree, git exports GIT_DIR pointing at that
# worktree's admin dir (.git/worktrees/<id>). It would override repository
# discovery in every `git -C <other worktree>` call (reading the wrong index, so
# the keeper listing would be wrong) and it dangles once that worktree is removed.
# git already chdir'd to the worktree's top level, so discovery finds the same repo.
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE

# --dry-run: print every removal and move instead of doing it (read by safe_rm_rf/mutate)
DRY_RUN=false

# Set when several worktrees are removed at once: offers "a" (yes for all) on the keep-files prompt
MULTI_REMOVAL=false
KEEP_FILES_FOR_ALL=false

# Kept files written this recently make the removal ask once more: a session may still be running there
RECENT_WRITE_SECONDS=600

# A worktree with Claude session activity this recent is never removed by --yes-safe
RECENT_SESSION_SECONDS=86400

# How many lines of the kept-files listing to print after a keep-in-place removal
KEPT_LISTING_LINES=200

# --yes-safe: answer the questions of a current-worktree cleanup without a terminal.
# Only the prompt ids below get an answer; any other prompt stops the run.
ASSUME_YES=false
declare -rA YES_ANSWERS=(
    [remove-current]=y          # Remove this worktree?
    [keep-files]=y              # Keep the unversioned files in place? (never no)
    [delete-unmerged-branch]=n  # an unmerged branch is never deleted
    [remove-orphans]=n          # orphaned directories are never deleted
)

# --force: clean up the current worktree although its branch is not merged (the
# branch is then kept). Overrides nothing else: every other safety stop still stops.
FORCE_UNMERGED=false

# Every prompt goes through ask, so --yes-safe cannot auto-answer a question it does
# not know. Sets ASK_ANSWER. End of input never counts as an answer: it stops
# the run instead of falling back to the prompt's default.
# Usage: ask <prompt_id> <question> <what has happened so far, for the stop message>
ASK_ANSWER=""
ask() {
    local id="$1" question="$2" so_far="$3"
    ASK_ANSWER=""
    if [[ "$ASSUME_YES" == true ]]; then
        if [[ -n "${YES_ANSWERS[$id]:-}" ]]; then
            ASK_ANSWER="${YES_ANSWERS[$id]}"
            echo "${question}${ASK_ANSWER} (--yes-safe)"
            return 0
        fi
        die "--yes-safe does not answer \"${question% }\"; stopping, ${so_far}"
    fi
    echo -n "$question"
    IFS= read -r ASK_ANSWER || die "No answer (end of input); stopping, ${so_far}"
}

show_help() {
    cat << 'EOF'
Usage: git worktree-cleanup [-i|--interactive] [-l|--list] [-n|--dry-run] [--yes-safe] [--force] [--no-signals]

Interactively remove git worktrees.

When run from within a worktree, offers to clean up that worktree directly.
When run from the main repository (or with -i), displays a numbered list
of all worktrees with branch information including:
  - Branch name
  - Commit hash
  - Upstream tracking status (ahead/behind)
  - Last commit message

Run from inside a linked worktree, it cleans up that worktree, and only when its
branch is merged into the main branch: by git history, or by a merged MR/PR into
the main branch whose head contains the branch tip, with no MR/PR of the branch
still open. Otherwise it stops before touching anything, unless --force.

A worktree with submodules is removed only when every submodule, recursively, is
clean (no change, no untracked file, only build/IDE ignored files), has nothing
in progress, no stash, and its HEAD and local branches are on remote-tracking
refs; --yes-safe then forces the removal git refuses for submodules.

Removing a worktree shows every MR/PR of its branch (GitLab or GitHub). A
branch that git history does not show merged is still deleted when one of its
MRs/PRs into the main branch is merged and the branch has no commit beyond that
MR's head (squash and rebase merges). A branch with an open MR/PR is never
deleted without asking.

Each worktree also shows whether it may still be needed:
  - keep: unversioned files worth keeping (untracked or ignored files that are
    not build output, IDE state, or an identical copy of the main repo's file;
    fifos, sockets and empty directories are never kept)
  - sessions: Claude Code sessions started in the worktree directory

Select one worktree or several at once ("3 7 12-40"); the whole selection is
validated and confirmed before anything is removed.

Options:
    -i, --interactive   Force interactive selection even when in a worktree
    -l, --list          Only print the list and exit (read-only: no prune, no prompts)
    -n, --dry-run       Print every removal and move instead of doing it
    --yes-safe          Clean up the current worktree without asking: remove it,
                        keep its unversioned files in place, keep an unmerged
                        branch, skip orphaned directories. Every safety question
                        (unsaved changes, recently written files, git refusing a
                        plain removal, ...) stops the run instead. Only inside a
                        linked worktree; combines with --dry-run and --force.
                        Refuses a worktree with Claude session activity in the
                        last 24 hours (--force does not override that)
    --force             Clean up the current worktree although its branch is not
                        merged (see below); the branch is kept. Overrides only
                        that refusal: unsaved changes, recently written files,
                        mounts, changed files and git refusing a plain removal
                        still stop the run, nothing is ever force-removed by it.
                        With --yes-safe: no questions; alone: the usual questions
    --no-signals        Skip the keep/sessions scan (faster on hundreds of worktrees)

Examples:
    git worktree-cleanup        # Clean current worktree, or list if in main repo
    git worktree-cleanup -i     # Always show interactive list
    git worktree-cleanup -l     # Just print the list
    git worktree-cleanup --yes-safe  # Clean up the current worktree, no questions
EOF
}

# Get formatted branch info for a worktree
# Usage: get_worktree_branch_info <branch_name>
get_worktree_branch_info() {
    local branch="$1"
    local commit_hash
    local commit_msg
    local upstream_info=""

    # Get short commit hash
    commit_hash=$(git rev-parse --short "$branch" 2>/dev/null || echo "??????")

    # Get first line of commit message (truncated to 60 chars)
    commit_msg=$(git log -1 --format='%s' "$branch" 2>/dev/null || echo "")
    commit_msg="${commit_msg:0:60}"

    # Get upstream tracking info
    local upstream
    if upstream=$(git rev-parse --abbrev-ref "${branch}@{upstream}" 2>/dev/null); then
        local ahead behind
        ahead=$(git rev-list --count "${upstream}..${branch}" 2>/dev/null || echo 0)
        behind=$(git rev-list --count "${branch}..${upstream}" 2>/dev/null || echo 0)

        if [[ "$ahead" -gt 0 ]] && [[ "$behind" -gt 0 ]]; then
            upstream_info="${COLOR_YELLOW}[${upstream}: ahead ${ahead}, behind ${behind}]${COLOR_RESET}"
        elif [[ "$ahead" -gt 0 ]]; then
            upstream_info="${COLOR_GREEN}[${upstream}: ahead ${ahead}]${COLOR_RESET}"
        elif [[ "$behind" -gt 0 ]]; then
            upstream_info="${COLOR_RED}[${upstream}: behind ${behind}]${COLOR_RESET}"
        else
            upstream_info="[${upstream}]"
        fi
    fi

    echo -e "${COLOR_GREEN}${branch}${COLOR_RESET} ${commit_hash} ${upstream_info} ${commit_msg}"
}

# Compute keeper-file summaries for many worktrees in parallel (one git scan each)
# Output lines: "<path>\t<keeper_count>\t<newest_mtime_epoch>\t<discarded_count>"
# Usage: compute_keeper_summaries <main_repo_root> <worktree_path>...
compute_keeper_summaries() {
    local main_root="$1"
    shift
    [[ $# -gt 0 ]] || return 0

    # shellcheck disable=SC2016 # expanded by the inner bash
    local worker='source "$1"; read -r count newest discarded < <(worktree_keeper_summary "$3" "$2"); printf "%s\t%s\t%s\t%s\n" "$3" "$count" "$newest" "$discarded"'
    printf '%s\0' "$@" \
        | xargs -0 -r -n 1 -P "$(nproc 2>/dev/null || echo 4)" bash -c "$worker" _ "${SCRIPT_DIR}/lib/common.sh" "$main_root"
}

# Format the "do I still need this" signals of a worktree
# Usage: format_worktree_signals <keeper_count> <keeper_newest> <session_count> <session_newest>
format_worktree_signals() {
    local keep_count="$1" keep_newest="$2" session_count="$3" session_newest="$4" discarded_count="${5:-0}"
    local keep sessions

    if [[ "$keep_count" == "?" ]]; then
        keep="${COLOR_RED}keep: ? (could not list all unversioned files)${COLOR_RESET}"
    elif [[ "$keep_count" -gt 0 ]]; then
        keep="${COLOR_YELLOW}keep: ${keep_count} files, newest $(date -d "@${keep_newest}" +%F)${COLOR_RESET}"
    elif [[ "$discarded_count" -gt 0 ]]; then
        keep="${COLOR_DIM}nothing to keep, ${discarded_count} build/IDE/copied entries${COLOR_RESET}"
    else
        keep="${COLOR_DIM}no unversioned files${COLOR_RESET}"
    fi

    if [[ "$session_count" -gt 0 ]]; then
        sessions="sessions: ${session_count}, last $(date -d "@${session_newest}" +%F)"
    else
        sessions="${COLOR_DIM}no sessions${COLOR_RESET}"
    fi

    echo -e "${keep} ${COLOR_DIM}·${COLOR_RESET} ${sessions}"
}

# Print the branch a worktree is on, or was on before a rebase or bisect that
# detached it, or "detached"
# Usage: worktree_branch_name <worktree_path>
worktree_branch_name() {
    local wt="$1" name state state_path
    # Full ref, not --short: that prints heads/<name> when a tag has the same name
    if name=$(git -C "$wt" symbolic-ref --quiet HEAD 2>/dev/null) && [[ "$name" == refs/heads/* ]]; then
        echo "${name#refs/heads/}"
        return 0
    fi
    for state in rebase-merge/head-name rebase-apply/head-name BISECT_START; do
        state_path=$(git -C "$wt" rev-parse --path-format=absolute --git-path "$state" 2>/dev/null) || continue
        [[ -f "$state_path" ]] || continue
        read -r name < "$state_path" || true
        name="${name#refs/heads/}"
        if [[ -n "$name" ]] && git -C "$wt" show-ref --verify --quiet "refs/heads/${name}"; then
            echo "$name"
            return 0
        fi
    done
    echo detached
}

# Remove a worktree but keep its keeper files at their original path: hard-link
# them into a temp dir next to the worktree (same file system, so instant and
# free), verify the copy, `git worktree remove --force`, recreate the dir with the
# WORKTREE_ARCHIVED_MARKER first (so orphan cleanup leaves it alone even if this
# is interrupted), move the files back, verify them in place, and only then
# delete the temp dir. `git wt` restores the files on the next checkout. If
# anything fails after the copy, the temp dir is kept and its path printed.
# Usage: remove_worktree_keeping_files <worktree_path> <main_worktree> <rel_path>...
remove_worktree_keeping_files() {
    local wt="$1" main_worktree="$2"
    shift 2

    local branch_name commit_sha
    branch_name=$(worktree_branch_name "$wt")
    commit_sha=$(git -C "$wt" rev-parse HEAD 2>/dev/null || echo unknown)

    # Re-check right before the removal: git worktree remove --force does not stop
    # at mount points, and the prompts in remove_worktree may have waited a while
    require_no_mounts "$wt" "force-remove $wt"

    if [[ "$DRY_RUN" == true ]]; then
        local rel
        for rel in "$@"; do
            print_dim "dry-run: keep ${wt}/${rel}"
        done
        print_dim "dry-run: hard-link the $# kept files into a temp dir in $(dirname "$wt")"
        mutate git worktree remove --force "$wt"
        print_dim "dry-run: recreate $wt with ${WORKTREE_ARCHIVED_MARKER}, move the $# kept files back, delete the temp dir"
        return 0
    fi

    local tmp manifest
    tmp=$(mktemp -d "$(dirname "$wt")/.worktree-keep.XXXXXX") || die "Failed to create a temp dir next to $wt; nothing was removed"
    make_temp_file manifest || die "Failed to create a temp file; nothing was removed. Copy dir (empty): $tmp"

    if ! (cd "$wt" && printf '%s\0' "$@" | xargs -0 -r cp -al --parents -t "$tmp" --); then
        die "Hard-linking the kept files failed; the worktree was not removed. Files owned by another user cannot be hard-linked (fs.protected_hardlinks), nor can files on another file system. Partial copy: $tmp"
    fi
    _manifest_of_tree "$tmp" > "$manifest" || die "Cannot list the copy; the worktree was not removed. Copy: $tmp"
    if ! cmp -s "$manifest" <(_manifest_of_paths "$wt" "$@"); then
        die "The copy of the kept files does not match the originals; the worktree was not removed. Copy: $tmp"
    fi

    set_interrupt_note "The kept files of $wt are in $tmp (some may already be back in $wt)"

    if ! git worktree remove --force "$wt"; then
        die "git worktree remove failed; the kept files are safe in $tmp"
    fi
    if [[ -e "$wt" || -L "$wt" ]]; then
        die "$wt still exists after git worktree remove; the kept files are safe in $tmp"
    fi

    mkdir -p -- "$wt" || die "Failed to recreate $wt; the kept files are safe in $tmp"
    if ! (set -o noclobber; printf 'branch: %s\ncommit: %s\narchived: %s\n' "$branch_name" "$commit_sha" "$(date -Iseconds)" > "${wt}/${WORKTREE_ARCHIVED_MARKER}"); then
        die "Failed to write ${wt}/${WORKTREE_ARCHIVED_MARKER}; the kept files are safe in $tmp"
    fi

    _move_tree_into "$tmp" "$wt" || die "Moving the kept files back failed; the rest of them are in $tmp"
    if ! cmp -s "$manifest" <(_manifest_of_paths "$wt" "$@"); then
        die "The kept files in $wt do not match the copy; whatever was not moved back is in $tmp"
    fi
    _tree_has_no_files "$tmp" || die "Files were left behind in $tmp after moving them back; check it before deleting"
    rm -f -- "$manifest"
    safe_rm_rf "$tmp" "$(dirname "$tmp")" "$main_worktree" "$wt"
    clear_interrupt_note

    print_green "Worktree removed, $# unversioned files kept in place: $wt"

    # Show what stayed, at most KEPT_LISTING_LINES lines; read-only, and a listing
    # failure never fails the run
    local listing=""
    if command -v tree >/dev/null 2>&1; then
        listing=$(tree -a "$wt") || warn "Could not list $wt with tree"
    else
        listing=$(cd -- "$wt" && find . -mindepth 1 | LC_ALL=C sort) || warn "Could not list $wt"
    fi
    if [[ -n "$listing" ]]; then
        local -a listing_lines=()
        mapfile -t listing_lines <<< "$listing"
        printf '%s\n' "${listing_lines[@]:0:KEPT_LISTING_LINES}"
        if [[ ${#listing_lines[@]} -gt $KEPT_LISTING_LINES ]]; then
            echo "… $(( ${#listing_lines[@]} - KEPT_LISTING_LINES )) more lines"
        fi
    fi
}

# Print what a forced removal of a worktree would lose besides unversioned files:
# changes to tracked files, an operation in progress, files git was told to
# ignore changes of (skip-worktree, assume-unchanged), and commits no branch,
# tag or remote reaches. Prints nothing when clean; a check that cannot run
# prints a line too, so the caller asks before removing.
# Usage: worktree_unsaved_state <worktree_path>
worktree_unsaved_state() {
    local wt="$1"
    local status
    status=$(git -C "$wt" status --porcelain --untracked-files=no) || { echo "  cannot read git status"; return 0; }
    [[ -z "$status" ]] || printf '%s\n' "$status" | sed 's/^/  /'

    local state state_path
    if git -C "$wt" rev-parse --path-format=absolute --git-path HEAD >/dev/null 2>&1; then
        for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
            state_path=$(git -C "$wt" rev-parse --path-format=absolute --git-path "$state" 2>/dev/null) || continue
            [[ ! -e "$state_path" ]] || echo "  operation in progress: ${state}"
        done
    else
        echo "  cannot check for operations in progress (git too old?)"
    fi

    # ls-files -v tags skip-worktree files with S and assume-unchanged ones in lowercase
    local flagged
    if flagged=$(git -C "$wt" ls-files -v); then
        printf '%s\n' "$flagged" | awk '/^S / { print "  skip-worktree: " substr($0, 3) } /^[a-z] / { print "  assume-unchanged: " substr($0, 3) }'
    else
        echo "  cannot check for skip-worktree and assume-unchanged files"
    fi

    local unreachable
    if unreachable=$(git -C "$wt" rev-list --count HEAD --not --branches --tags --remotes 2>/dev/null); then
        [[ "$unreachable" -eq 0 ]] || echo "  ${unreachable} commits at HEAD are on no branch, tag or remote"
    else
        echo "  cannot check for commits only reachable from HEAD"
    fi
    return 0
}

# Print the newest mtime (epoch) of the given files under a root, 0 when none
# Usage: newest_mtime <root> <rel_path>...
newest_mtime() {
    local root="$1"
    shift
    { (cd -- "$root" && printf '%s\0' "$@" | xargs -0 -r stat -c '%Y' -- 2>/dev/null) || true; } \
        | awk 'BEGIN { max = 0 } { if ($1 > max) max = $1 } END { print max }'
}

# True when the only thing that makes a plain `git worktree remove` refuse is
# untracked content: git status shows untracked entries and nothing else (no
# tracked change, staged change or conflict, submodule changes included) and the
# worktree has no submodules (gitlinks); a locked worktree never gets this far
# (require_fully_removable stops it before any prompt). Anything else, or
# a check that fails, returns false so the caller keeps asking (and --yes-safe
# stops). Callers use it only after a complete keeper listing found no keepers,
# so every untracked entry is one already shown as deleted with the worktree.
# With "submodules-ok" (only after verify_worktree_submodules passed) the
# submodules are an accepted obstacle too: then gitlinks are allowed and a status
# with no entries at all also qualifies, since git refuses because of them alone.
# Usage: untracked_is_only_obstacle <worktree_path> [submodules-ok]
untracked_is_only_obstacle() {
    local wt="$1" mode="${2:-}" status gitlinks line
    status=$(git -C "$wt" status --porcelain=v1 --untracked-files=normal --ignore-submodules=none) || return 1
    if [[ -n "$status" ]]; then
        while IFS= read -r line; do
            [[ "$line" == "?? "* ]] || return 1
        done <<< "$status"
    elif [[ "$mode" != submodules-ok ]]; then
        return 1
    fi

    [[ "$mode" != submodules-ok ]] || return 0
    gitlinks=$(git -C "$wt" ls-files --stage) || return 1
    ! grep -q '^160000 ' <<< "$gitlinks"
}

# Print "^<sha>" for every local ref of a repository (remote-tracking refs aside)
# that one of its remotes has under the same name at the same object: tags and
# notes fetched from the remote, a branch pushed under its own name. Asks each
# remote once with `git ls-remote --refs`, limited to VCS_LOOKUP_TIMEOUT seconds
# (default 10) and never prompting for credentials. Returns non-zero when there is
# no remote, any remote cannot be asked, or a remote is a local path inside one of
# the given directories (the worktree and its admin dir): that "remote" is deleted
# together with the worktree, so it backs nothing.
# Usage: remote_backed_refs <repo_dir> [doomed_dir...]
remote_backed_refs() {
    local repo="$1" remotes remote local_refs listing sha ref
    shift
    local -a doomed=()
    local dir
    for dir in "$@"; do
        doomed+=("$(realpath -m -- "$dir")")
    done
    remotes=$(git -C "$repo" remote) || return 1
    [[ -n "$remotes" ]] || return 1

    # Every URL of every remote: a local path (file:// included; not scheme://...
    # and not scp-like host:path) must not lie inside a directory about to be deleted
    local urls url local_path
    while IFS= read -r remote; do
        [[ -n "$remote" ]] || continue
        urls=$(git -C "$repo" remote get-url --all "$remote") || return 1
        while IFS= read -r url; do
            [[ -n "$url" ]] || continue
            if [[ "$url" == file://* ]]; then
                local_path="${url#file://}"
            elif [[ "$url" =~ ^[a-zA-Z][a-zA-Z0-9+.-]*:// ]]; then
                continue
            elif [[ "$url" =~ ^[^/]*: ]]; then
                continue
            else
                local_path="$url"
            fi
            local_path=$(cd -- "$repo" && realpath -m -- "$local_path") || return 1
            for dir in "${doomed[@]}"; do
                if [[ "$local_path" == "$dir" || "$local_path" == "${dir}/"* ]]; then
                    return 1
                fi
            done
        done <<< "$urls"
    done <<< "$remotes"
    local_refs=$(git -C "$repo" for-each-ref --format='%(objectname) %(refname)') || return 1

    local -A local_by_name=()
    while read -r sha ref; do
        [[ -n "$ref" && "$ref" != refs/remotes/* ]] || continue
        local_by_name["$ref"]="$sha"
    done <<< "$local_refs"

    while IFS= read -r remote; do
        [[ -n "$remote" ]] || continue
        listing=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}" \
            timeout "${VCS_LOOKUP_TIMEOUT:-10}" git -C "$repo" ls-remote --refs "$remote" < /dev/null) || return 1
        while IFS=$'\t' read -r sha ref; do
            [[ -n "$ref" ]] || continue
            if [[ "${local_by_name[$ref]:-}" == "$sha" ]]; then
                printf '^%s\n' "$sha"
            fi
        done <<< "$listing"
    done <<< "$remotes"
}

# Verify that removing a worktree loses nothing inside its submodules. git refuses
# a plain `git worktree remove` for any worktree with initialized submodules, and
# --force deletes their working trees and the git dirs under the worktree's admin
# dir (<main>/.git/worktrees/<id>/modules/...), so for EVERY initialized submodule,
# recursively, all of these must hold:
#   - git status shows nothing: no tracked, staged or conflicted change and no
#     untracked file (ignored files are allowed only when they are build output or
#     IDE state per KEEPER_EXCLUDE_*, and contain no nested repository)
#   - no rebase, merge, cherry-pick, revert or bisect in progress
#   - no file marked assume-unchanged or skip-worktree
#   - no commit reachable from any of its refs (branches, tags, notes, stash, HEAD)
#     is missing from its remote-tracking refs; when some are, the refs its remote
#     has under the same name at the same object (fetched tags and notes) count as
#     pushed too (one `git ls-remote` per remote, only then), and whatever is left
#     is refused by name. A shallow clone whose HEAD cannot be shown pushed this
#     way is refused as unverifiable
#   - no stash entries, no linked worktrees of the submodule repo
#   - its working tree really is this directory (a gitfile pointing elsewhere fails)
# A gitlink directory that is not a checked-out submodule (foreach skips it) must
# be absent or empty, and every git dir under the worktree's modules dir must
# belong to a checked-out submodule (a deinitialized one cannot be verified). Any
# git or find error fails the check too (fail closed).
# Sets SUBMODULES_PRESENT (true/false), SUBMODULE_REPORT and SUBMODULE_PROBLEMS
# (one line each); returns 0 only when there are no problems.
# Submodule working trees are tracked gitlinks of the worktree, so they never
# appear in the keeper or discarded lists, and the nested-repository guard (which
# only searches discarded directories) does not see them; this check covers them.
# Usage: verify_worktree_submodules <worktree_path>
SUBMODULES_PRESENT=false
SUBMODULE_REPORT=""
SUBMODULE_PROBLEMS=""
verify_worktree_submodules() {
    local wt="$1"
    SUBMODULES_PRESENT=false
    SUBMODULE_REPORT=""
    SUBMODULE_PROBLEMS=""

    local index modules_dir wt_git_dir
    if ! index=$(git -C "$wt" ls-files --stage) \
        || ! modules_dir=$(git -C "$wt" rev-parse --path-format=absolute --git-path modules) \
        || ! wt_git_dir=$(git -C "$wt" rev-parse --absolute-git-dir); then
        SUBMODULES_PRESENT=true
        SUBMODULE_PROBLEMS="  cannot read the index or the git dir of $wt"
        return 1
    fi
    if ! grep -q '^160000 ' <<< "$index" && [[ ! -e "$modules_dir" ]]; then
        return 0
    fi
    SUBMODULES_PRESENT=true

    local -a problems=() report=()
    local list_file
    make_temp_file list_file || { SUBMODULE_PROBLEMS="  cannot create a temp file"; return 1; }

    # Initialized (checked-out) submodules, recursively, relative to the worktree
    # shellcheck disable=SC2016 # expanded by the shell git submodule foreach runs
    if ! git -C "$wt" submodule foreach --quiet --recursive 'printf "%s\0" "$displaypath"' > "$list_file"; then
        SUBMODULE_PROBLEMS="  cannot list the submodules of $wt (git submodule foreach failed)"
        return 1
    fi
    local -a subs=()
    mapfile -d '' -t subs < "$list_file"

    local exclude_re
    exclude_re=$(_keeper_exclude_regex)

    local backed_file
    make_temp_file backed_file || { SUBMODULE_PROBLEMS="  cannot create a temp file"; return 1; }

    local -a sub_git_dirs=()
    local sp sub git_dir status state state_path head_ref="" stash entry found
    for sp in "${subs[@]}"; do
        sub="${wt}/${sp}"
        if ! git_dir=$(git -C "$sub" rev-parse --absolute-git-dir); then
            problems+=("  ${sp}: cannot resolve its git dir")
            continue
        fi
        sub_git_dirs+=("$git_dir")

        # The repo must have this directory as its working tree, or the checks below
        # would verify some other tree than the one --force deletes
        local top=""
        if ! top=$(git -C "$sub" rev-parse --show-toplevel) \
            || [[ "$(realpath -e -- "$top")" != "$(realpath -e -- "$sub")" ]]; then
            problems+=("  ${sp}: its git dir has a different working tree (${top:-?}); cannot verify it")
            continue
        fi

        local flagged=""
        if ! flagged=$(git -C "$sub" ls-files -v); then
            problems+=("  ${sp}: cannot check for assume-unchanged or skip-worktree files")
        elif flagged=$(awk '/^S / { print "skip-worktree " substr($0, 3) } /^[a-z] / { print "assume-unchanged " substr($0, 3) }' <<< "$flagged") && [[ -n "$flagged" ]]; then
            problems+=("  ${sp}: files git ignores changes of: $(head -n 3 <<< "$flagged" | tr '\n' ';')")
        fi

        local sub_worktrees=""
        if ! sub_worktrees=$(git -C "$sub" worktree list --porcelain); then
            problems+=("  ${sp}: cannot list its linked worktrees")
        elif [[ "$(grep -c '^worktree ' <<< "$sub_worktrees")" -gt 1 ]]; then
            problems+=("  ${sp}: the submodule repo has linked worktrees of its own (git -C $(printf '%q' "$sub") worktree prune, if they are stale)")
        fi

        if ! status=$(git -C "$sub" status --porcelain=v1 --untracked-files=normal --ignore-submodules=none); then
            problems+=("  ${sp}: cannot read git status")
        elif [[ -n "$status" ]]; then
            problems+=("  ${sp}: has changes or untracked files: $(head -n 3 <<< "$status" | tr '\n' ';')")
        fi

        for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
            if ! state_path=$(git -C "$sub" rev-parse --path-format=absolute --git-path "$state"); then
                problems+=("  ${sp}: cannot check for an operation in progress")
                break
            fi
            [[ ! -e "$state_path" ]] || problems+=("  ${sp}: operation in progress: ${state}")
        done

        # Ignored content must be build output or IDE state, with no repository inside
        if ! git -C "$sub" ls-files -z --others --ignored --exclude-standard --directory > "$list_file"; then
            problems+=("  ${sp}: cannot list its ignored files")
        else
            local -a ignored=()
            mapfile -d '' -t ignored < "$list_file"
            for entry in "${ignored[@]}"; do
                if [[ ! "$entry" =~ $exclude_re ]]; then
                    problems+=("  ${sp}: ignored file that is not build output or IDE state: ${entry}")
                elif [[ "$entry" == */ && -d "${sub}/${entry}" && ! -L "${sub}/${entry%/}" ]]; then
                    if ! found=$(find -P "${sub}/${entry%/}" -name .git -prune -print -quit); then
                        problems+=("  ${sp}: cannot search ${entry} for nested repositories")
                    elif [[ -n "$found" ]]; then
                        problems+=("  ${sp}: ${entry} contains a git repository: ${found}")
                    fi
                fi
            done
        fi

        # Pushed state: every commit reachable from its refs and HEAD must be on a
        # remote-tracking ref, or on a ref the remote has by the same name at the same
        # object (the remote is asked only when the first, offline count is not 0)
        : > "$backed_file"
        local unpushed=""
        if ! unpushed=$(git -C "$sub" rev-list --count --all --not --remotes); then
            problems+=("  ${sp}: cannot count commits missing from its remote-tracking refs")
            unpushed=""
        elif [[ "$unpushed" != 0 ]]; then
            if ! remote_backed_refs "$sub" "$wt" "$wt_git_dir" > "$backed_file"; then
                problems+=("  ${sp}: ${unpushed} commits are on no remote-tracking ref and its remote could not be asked which refs it has (or is a path inside the worktree being removed); cannot verify them")
                unpushed=""
            elif ! unpushed=$(git -C "$sub" rev-list --count --all --not --remotes --stdin < "$backed_file"); then
                problems+=("  ${sp}: cannot count commits missing from its remote")
                unpushed=""
            fi
        fi
        if [[ -n "$unpushed" && "$unpushed" != 0 ]]; then
            # Name what is left: HEAD and every local ref with commits the remote lacks
            local -a culprits=()
            local -A backed_shas=()
            local backed_line ref_sha ref_name ref_unpushed
            while IFS= read -r backed_line; do
                [[ -z "$backed_line" ]] || backed_shas["${backed_line#^}"]=1
            done < "$backed_file"
            local local_refs=""
            if ! local_refs=$( { echo "$(git -C "$sub" rev-parse HEAD) HEAD"; git -C "$sub" for-each-ref --format='%(objectname) %(refname)'; } ); then
                problems+=("  ${sp}: ${unpushed} commits reachable from its refs are not on its remote, and its refs cannot be listed")
            else
                while read -r ref_sha ref_name; do
                    [[ -n "$ref_name" && "$ref_name" != refs/remotes/* ]] || continue
                    [[ -z "${backed_shas[$ref_sha]:-}" ]] || continue
                    if ! ref_unpushed=$(git -C "$sub" rev-list --count "$ref_sha" --not --remotes --stdin < "$backed_file"); then
                        culprits+=("${ref_name} (cannot check)")
                    elif [[ "$ref_unpushed" != 0 ]]; then
                        culprits+=("${ref_name#refs/} (${ref_unpushed})")
                    fi
                done <<< "$local_refs"
                local named
                named=$(printf '%s, ' "${culprits[@]:0:10}")
                named="${named%, }"
                [[ ${#culprits[@]} -le 10 ]] || named="${named}, … $(( ${#culprits[@]} - 10 )) more"
                if [[ -e "${git_dir}/shallow" ]]; then
                    problems+=("  ${sp}: shallow clone, cannot verify locally that its commits are on the remote: ${named:-?}")
                else
                    problems+=("  ${sp}: ${unpushed} commits are on no remote-tracking ref and on no ref its remote has (unpushed work): ${named:-?}")
                fi
            fi
            unset backed_shas
        fi

        local containing=""
        if containing=$(git -C "$sub" for-each-ref --contains HEAD --format='%(refname:short)' refs/remotes) && [[ -n "$containing" ]]; then
            head_ref=$(head -n 1 <<< "$containing")
        elif [[ "$unpushed" == 0 ]]; then
            head_ref="a ref its remote has"
        fi

        if ! stash=$(git -C "$sub" stash list); then
            problems+=("  ${sp}: cannot read its stash")
        elif [[ -n "$stash" ]]; then
            problems+=("  ${sp}: has $(grep -c '' <<< "$stash") stash entries")
        fi

        report+=("  ${sp}: clean, HEAD on ${head_ref:-?}, git dir ${git_dir}")
        head_ref=""
    done

    # A gitlink directory foreach did not visit (not a checked-out submodule, e.g. its
    # gitfile is gone) must be absent or empty: --force would delete its content
    # unverified. Checked for the worktree and, recursively, for each submodule.
    local -A visited=()
    for sp in "${subs[@]}"; do
        visited["$sp"]=1
    done
    local repo_prefix repo_dir line gitlink content
    for repo_prefix in "" "${subs[@]}"; do
        repo_dir="$wt"
        [[ -z "$repo_prefix" ]] || repo_dir="${wt}/${repo_prefix}"
        if ! git -C "$repo_dir" ls-files -z --stage > "$list_file"; then
            problems+=("  ${repo_prefix:-.}: cannot read its index")
            continue
        fi
        while IFS= read -r -d '' line; do
            [[ "$line" == "160000 "* ]] || continue
            gitlink="${line#*$'\t'}"
            [[ -z "$repo_prefix" ]] || gitlink="${repo_prefix}/${gitlink}"
            [[ -z "${visited[$gitlink]:-}" ]] || continue
            [[ -e "${wt}/${gitlink}" || -L "${wt}/${gitlink}" ]] || continue
            if [[ ! -d "${wt}/${gitlink}" || -L "${wt}/${gitlink}" ]]; then
                problems+=("  ${gitlink}: gitlink path is not a directory")
            elif ! content=$(find -P "${wt}/${gitlink}" -mindepth 1 -print -quit); then
                problems+=("  ${gitlink}: cannot check whether it is empty")
            elif [[ -n "$content" ]]; then
                problems+=("  ${gitlink}: has content but is not a checked-out submodule; cannot verify it")
            fi
        done < "$list_file"
    done

    # Submodule git dirs under the worktree's modules dir that no checked-out
    # submodule uses (deinitialized ones) would be deleted unverified
    if [[ -e "$modules_dir" ]]; then
        # Every git dir has an objects dir, also a half-deleted one without HEAD
        # No -prune: a submodule path component named "objects" must not hide a git dir
        # below it; the sibling filter below drops object stores and their subdirs.
        # -mindepth 2: $modules_dir itself is never a submodule git dir
        if ! find -P "$modules_dir" -mindepth 2 -name objects -type d -printf '%h\0' > "$list_file"; then
            problems+=("  cannot search ${modules_dir} for submodule git dirs")
        else
            local -a module_dirs=()
            mapfile -d '' -t module_dirs < "$list_file"
            local module_dir known resolved
            for module_dir in "${module_dirs[@]}"; do
                # A git dir has refs, HEAD or config next to objects; lfs/objects and
                # annex/objects inside a submodule git dir are object stores, not git dirs
                [[ -d "${module_dir}/refs" || -e "${module_dir}/HEAD" || -e "${module_dir}/config" ]] || continue
                resolved=$(realpath -e -- "$module_dir") || { problems+=("  cannot resolve ${module_dir}"); continue; }
                local known_dir=false
                for known in "${sub_git_dirs[@]}"; do
                    [[ "$(realpath -m -- "$known")" != "$resolved" ]] || { known_dir=true; break; }
                done
                [[ "$known_dir" == true ]] || problems+=("  submodule git dir without a checked-out submodule, cannot verify it: ${module_dir}")
            done
        fi
    fi

    if [[ ${#report[@]} -gt 0 ]]; then
        SUBMODULE_REPORT=$(printf '%s\n' "${report[@]}")
    else
        SUBMODULE_REPORT="  no checked-out submodule, nothing in the modules dir to lose"
    fi
    if [[ ${#problems[@]} -gt 0 ]]; then
        SUBMODULE_PROBLEMS=$(printf '%s\n' "${problems[@]}")
        return 1
    fi
    return 0
}

# Set WORKTREE_LOCKED to true or false for a worktree (paths compared resolved).
# Returns non-zero when that cannot be determined.
# Usage: worktree_lock_state <worktree_path>
WORKTREE_LOCKED=""
worktree_lock_state() {
    local wt="$1" wt_resolved entry current="" worktree_list
    WORKTREE_LOCKED=""
    wt_resolved=$(realpath -e -- "$wt") || return 1
    worktree_list=$(git worktree list --porcelain) || return 1
    WORKTREE_LOCKED=false
    while IFS= read -r entry; do
        if [[ "$entry" == "worktree "* ]]; then
            current=$(realpath -m -- "${entry#worktree }")
        elif [[ "$entry" == "locked"* && "$current" == "$wt_resolved" ]]; then
            WORKTREE_LOCKED=true
        fi
    done <<< "$worktree_list"
}

# Die unless git can delete the whole worktree: it is not locked, and every
# directory in it (the worktree dir included, its .git file excluded) and its
# parent are writable, readable and searchable, so `git worktree remove` cannot
# fail halfway and leave a half-deleted, unregistered worktree behind. Symlinks
# are not followed. A directory that cannot be searched fails the check too.
# Usage: require_fully_removable <worktree_path>
require_fully_removable() {
    local wt="$1" blocked_file
    worktree_lock_state "$wt" || die "Cannot tell whether $wt is locked; this worktree was not removed"
    [[ "$WORKTREE_LOCKED" == false ]] || die "$wt is locked (git worktree unlock $(printf '%q' "$wt") first); this worktree was not removed"

    [[ -w "$(dirname "$wt")" && -x "$(dirname "$wt")" ]] || die "$(dirname "$wt") is not writable, so $wt cannot be deleted; this worktree was not removed"

    make_temp_file blocked_file || die "Failed to create a temp file; this worktree was not removed"
    # Relative to the worktree, so its own .git file is pruned by a literal path,
    # never by a pattern built from the worktree path
    local find_ok=true
    (cd -- "$wt" && find -P . -path ./.git -prune -o -type d \( ! -writable -o ! -readable -o ! -executable \) -print0) > "$blocked_file" \
        || find_ok=false
    local -a blocked=()
    mapfile -d '' -t blocked < "$blocked_file"
    rm -f -- "$blocked_file"
    if [[ ${#blocked[@]} -gt 0 ]]; then
        warn "git could not delete everything in these directories (not writable, readable or searchable by you):"
        local dir
        for dir in "${blocked[@]}"; do
            printf '  %s\n' "${wt}/${dir#./}" >&2
        done
    fi
    [[ "$find_ok" == true ]] || die "Could not check every directory of $wt (see above); this worktree was not removed"
    [[ ${#blocked[@]} -eq 0 ]] || die "Fix their permissions first (e.g. chmod u+rwx); this worktree was not removed"
}

# MR/PR lookups per branch, made at most once per run (see vcs_branch_mrs)
declare -A MR_LINES=()     # branch -> TSV lines from vcs_branch_mrs
declare -A MR_LOOKED_UP=() # branch -> ok | failed
declare -A MR_SHOWN=()     # branch -> 1 once its status was printed

# Look up the MRs/PRs of a branch once per run; MR_LOOKED_UP says whether it worked
# Usage: lookup_branch_mrs <branch>
lookup_branch_mrs() {
    local branch="$1" lines
    [[ -z "${MR_LOOKED_UP[$branch]:-}" ]] || return 0
    if lines=$(vcs_branch_mrs "$branch"); then
        MR_LINES[$branch]="$lines"
        MR_LOOKED_UP[$branch]=ok
    else
        MR_LINES[$branch]=""
        MR_LOOKED_UP[$branch]=failed
    fi
}

# Print every MR/PR of a branch, one line each, an open one in warning colour.
# A failed lookup is said out loud. Prints once per branch and run.
# Usage: show_branch_mr_status <branch>
show_branch_mr_status() {
    local branch="$1"
    [[ "$branch" != "detached" ]] || return 0
    ! is_main_branch "$branch" || return 0
    lookup_branch_mrs "$branch"

    [[ -z "${MR_SHOWN[$branch]:-}" ]] || return 0
    MR_SHOWN[$branch]=1

    if [[ "${MR_LOOKED_UP[$branch]}" == failed ]]; then
        warn "MR state of '${branch}' unknown: the lookup failed (no glab/gh, offline, timed out or an unexpected response)"
        return 0
    fi
    if [[ -z "${MR_LINES[$branch]}" ]]; then
        print_dim "No MR/PR for branch '${branch}'"
        return 0
    fi

    local state ref target sha merged_date
    while IFS=$'\t' read -r state ref target sha merged_date; do
        case "$state" in
            open)   echo -e "${COLOR_BOLD}${COLOR_YELLOW}${ref} → ${target}: open${COLOR_RESET}" ;;
            merged) print_green "${ref} → ${target}: merged ${merged_date}" ;;
            locked) print_dim "${ref} → ${target}: locked (a merge may be in progress)" ;;
            *)      print_dim "${ref} → ${target}: closed without merging" ;;
        esac
    done <<< "${MR_LINES[$branch]}"
}

# Decide whether a branch's work is merged, and how. Sets BRANCH_VERDICT to:
#   git     - the branch is an ancestor of the main branch (git branch -d works)
#   mr      - merged through an MR/PR although git history does not show it (squash
#             or rebase merge): an MR/PR of the branch has state merged AND targets
#             the main branch AND the local branch tip is that MR's head commit or an
#             ancestor of it, so the branch has no commit the MR did not carry
#   open-mr - an MR/PR of the branch is still open (or locked): work may continue there, so the
#             branch never counts as merged, whatever else holds
#   unknown - the MR lookup failed and git history does not show the branch merged
#   no      - none of the above (including a detached HEAD)
# BRANCH_VERDICT_REF names the MR/PR behind "mr" or "open-mr".
# Usage: branch_merge_verdict <branch> <main_branch>
BRANCH_VERDICT=""
BRANCH_VERDICT_REF=""
branch_merge_verdict() {
    local branch="$1" main_branch="$2"
    BRANCH_VERDICT=no
    BRANCH_VERDICT_REF=""
    [[ "$branch" != "detached" ]] || return 0

    lookup_branch_mrs "$branch"
    local state ref target sha merged_date
    if [[ "${MR_LOOKED_UP[$branch]}" == ok ]]; then
        while IFS=$'\t' read -r state ref target sha merged_date; do
            # locked: GitLab is merging it right now, not merged yet
            if [[ "$state" == open || "$state" == locked ]]; then
                BRANCH_VERDICT=open-mr
                BRANCH_VERDICT_REF="$ref"
                return 0
            fi
        done <<< "${MR_LINES[$branch]}"
    fi

    # Full refs on both sides: a tag named like the branch must not decide
    if git merge-base --is-ancestor "refs/heads/${branch}" "refs/heads/${main_branch}" 2>/dev/null; then
        BRANCH_VERDICT=git
        return 0
    fi

    if [[ "${MR_LOOKED_UP[$branch]}" != ok ]]; then
        BRANCH_VERDICT=unknown
        return 0
    fi

    local tip
    tip=$(git rev-parse --verify --quiet "refs/heads/${branch}^{commit}") || return 0
    while IFS=$'\t' read -r state ref target sha merged_date; do
        [[ "$state" == merged && "$target" == "$main_branch" ]] || continue
        [[ "$sha" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]] || continue
        if [[ "$tip" == "$sha" ]] \
            || { git cat-file -e "${sha}^{commit}" 2>/dev/null && git merge-base --is-ancestor "$tip" "$sha"; }; then
            BRANCH_VERDICT=mr
            BRANCH_VERDICT_REF="$ref"
            return 0
        fi
    done <<< "${MR_LINES[$branch]}"
}

# Cleaning up the worktree you are in is only for merged work: die, before anything
# is touched, unless the branch is merged by git history or through a merged MR/PR
# (see branch_merge_verdict) or --force was given
# Usage: require_merged_or_force <branch>
require_merged_or_force() {
    local branch="$1" main_branch why
    main_branch=$(get_main_branch)
    branch_merge_verdict "$branch" "$main_branch"
    case "$BRANCH_VERDICT" in
        git|mr) return 0 ;;
        open-mr) why="it still has open ${BRANCH_VERDICT_REF}, so work may continue on it" ;;
        unknown) why="git history does not show it merged into ${main_branch} and its MR state is unknown (the lookup failed)" ;;
        *)
            if [[ "$branch" == "detached" ]]; then
                why="the worktree has a detached HEAD"
            else
                why="it is merged into ${main_branch} neither by git history nor by a merged MR/PR whose head contains the branch tip"
            fi
            ;;
    esac

    if [[ "$FORCE_UNMERGED" == true ]]; then
        warn "Branch '${branch}' is not merged: ${why}. --force: cleaning up the worktree anyway; the branch is kept."
        return 0
    fi
    die "Branch '${branch}' is not merged: ${why}. Nothing was removed. Run again with --force to remove the worktree anyway (the branch is kept; every other safety check still applies)."
}

# A Claude session may still be working in the worktree: under --yes-safe die
# before anything is touched when one was active within RECENT_SESSION_SECONDS
# (or when that cannot be determined); interactively only warn, the user decides.
# --force does not override it.
# Usage: check_recent_session_activity <worktree_path>
check_recent_session_activity() {
    local wt="$1" last age when=""
    if last=$(claude_last_activity_for_path "$wt"); then
        [[ "$last" -gt 0 ]] || return 0
        age=$(( $(date +%s) - last ))
        # A timestamp in the future (clock skew) counts as just now
        if (( age < 0 )); then
            age=0
        fi
        [[ "$age" -lt "$RECENT_SESSION_SECONDS" ]] || return 0
        if [[ "$age" -lt 3600 ]]; then
            when="$(( age / 60 )) min ago"
        else
            when="$(( age / 3600 )) h ago"
        fi
        when="${when}, $(date -d "@${last}" '+%F %H:%M')"
    else
        when="unknown, the session lookup failed"
    fi

    if [[ "$ASSUME_YES" == true ]]; then
        die "Claude session activity in this worktree ${when}; this worktree was not removed. Run without --yes-safe to decide interactively."
    fi
    warn "Claude session activity in this worktree ${when}; a session may still be working here."
}

# Remove a worktree and optionally its branch. When the worktree has keeper
# files, offers to keep them in place (see remove_worktree_keeping_files).
# Usage: remove_worktree <path> <branch>
remove_worktree() {
    local selected_path="$1"
    local selected_branch="$2"
    local main_worktree
    main_worktree=$(get_main_repo_root)

    # The worktree may be the current directory, and after its removal (or its
    # recreation as a kept-files dir without .git) git can no longer find the repo
    # from there; every git call below, branch handling included, runs from the main repo
    cd "$main_worktree" || die "Failed to cd into $main_worktree"

    print_yellow "Removing worktree: $selected_path"
    show_branch_mr_status "$selected_branch"

    # A registered worktree whose directory is gone (prunable) has nothing to remove or check
    [[ -d "$selected_path" ]] || die "$selected_path does not exist; run without --dry-run so git worktree prune drops it"

    # git worktree remove, forced or not, deletes ignored files and does not stop at mount points
    require_no_mounts "$selected_path" "remove $selected_path"

    # Locked or partly undeletable: git would refuse late or stop halfway
    require_fully_removable "$selected_path"

    # Submodules: a forced removal deletes their working trees and git dirs, so it is
    # only allowed when nothing in them would be lost (see verify_worktree_submodules)
    local submodules_verified=false
    if verify_worktree_submodules "$selected_path"; then
        if [[ "$SUBMODULES_PRESENT" == true ]]; then
            submodules_verified=true
            echo "submodules verified safe:"
            echo "$SUBMODULE_REPORT"
        fi
    else
        warn "Its submodules hold state a forced removal would lose, or could not be checked:"
        echo "$SUBMODULE_PROBLEMS"
        if [[ "$ASSUME_YES" == true ]]; then
            die "--yes-safe never removes unverified submodules; this worktree was not removed"
        fi
        ask discard-submodules "Remove it anyway, losing that submodule state? [y/N]: " "this worktree was not removed"
        [[ "$ASK_ANSWER" =~ ^[Yy]$ ]] || die "Aborted; this worktree was not removed."
    fi

    # A list that could not be completed must never decide what survives a forced removal
    local keepers_file discarded_file
    make_temp_file keepers_file || die "Failed to create a temp file"
    make_temp_file discarded_file || die "Failed to create a temp file"
    if ! list_worktree_keeper_files "$selected_path" "$main_worktree" "$discarded_file" > "$keepers_file"; then
        die "Could not list all unversioned files of $selected_path (see above); nothing was removed"
    fi
    local -a keepers=() discarded=()
    mapfile -d '' -t keepers < "$keepers_file"
    mapfile -d '' -t discarded < "$discarded_file"
    rm -f -- "$keepers_file" "$discarded_file"

    local shown
    if [[ ${#discarded[@]} -gt 0 ]]; then
        echo "${#discarded[@]} unversioned entries are deleted with the worktree (build output, IDE state, copies identical to the main repo):"
        for shown in "${discarded[@]:0:10}"; do
            echo "  $shown"
        done
        [[ ${#discarded[@]} -le 10 ]] || echo "  … and $(( ${#discarded[@]} - 10 )) more"
    fi

    # A nested repository (a clone under build/, node_modules/, out/ ...) is never
    # build output: deleting it with the worktree needs an explicit yes
    if [[ ${#discarded[@]} -gt 0 ]]; then
        # Discarded directories, without any that lies inside another listed one,
        # so nothing is walked or reported twice
        local -a search_dirs=()
        local entry outer inside
        for entry in "${discarded[@]}"; do
            [[ "$entry" == */ ]] || continue
            [[ -d "${selected_path}/${entry}" && ! -L "${selected_path}/${entry%/}" ]] || continue
            inside=false
            for outer in "${discarded[@]}"; do
                if [[ "$outer" == */ && "$outer" != "$entry" && "$entry" == "$outer"* ]]; then
                    inside=true
                    break
                fi
            done
            [[ "$inside" == true ]] || search_dirs+=("${entry%/}")
        done

        # -P: never follow symlinks; prune at the first .git of each nested repo.
        # Fails closed: a directory that cannot be fully searched stops the run.
        local -a nested_repos=() found=()
        local found_file
        make_temp_file found_file || die "Failed to create a temp file; this worktree was not removed"
        for entry in "${search_dirs[@]}"; do
            if ! find -P "${selected_path}/${entry}" -name .git -prune -printf '%h\0' > "$found_file"; then
                rm -f -- "$found_file"
                die "Could not search ${selected_path}/${entry} for nested repositories (see above); this worktree was not removed"
            fi
            mapfile -d '' -t found < "$found_file"
            nested_repos+=("${found[@]}")
        done
        rm -f -- "$found_file"
        if [[ ${#nested_repos[@]} -gt 0 ]]; then
            warn "These directories deleted with the worktree contain a git repository:"
            printf '  %s\n' "${nested_repos[@]}"
            ask delete-nested-repos "Delete them with the worktree? [y/N]: " "this worktree was not removed"
            [[ "$ASK_ANSWER" =~ ^[Yy]$ ]] || die "Aborted; this worktree was not removed."
        fi
    fi

    local remove_error=""
    local keep_files=false
    if [[ ${#keepers[@]} -gt 0 ]]; then
        echo "${#keepers[@]} unversioned files worth keeping:"
        for shown in "${keepers[@]:0:10}"; do
            echo "  $shown"
        done
        [[ ${#keepers[@]} -le 10 ]] || echo "  … and $(( ${#keepers[@]} - 10 )) more"

        # A Claude session or an editor may still be writing here; asked even under "yes for all"
        local newest age
        newest=$(newest_mtime "$selected_path" "${keepers[@]}")
        age=$(( $(date +%s) - newest ))
        if [[ "$newest" -gt 0 ]] && [[ "$age" -lt "$RECENT_WRITE_SECONDS" ]]; then
            warn "The newest of these files was written ${age} s ago; something (a Claude session?) may still be writing in this worktree."
            ask recent-write "Continue removing it? [y/N]: " "this worktree was not removed"
            [[ "$ASK_ANSWER" =~ ^[Yy]$ ]] || die "Aborted; this worktree was not removed."
        fi
        if [[ "$KEEP_FILES_FOR_ALL" == true ]]; then
            echo "Keeping them in place (yes for all)."
            keep_files=true
        else
            if [[ "$MULTI_REMOVAL" == true ]]; then
                ask keep-files-multi "Keep them in place after removing the worktree? [Y/n/a=yes for all]: " "this worktree was not removed"
            else
                ask keep-files "Keep them in place after removing the worktree? [Y/n]: " "this worktree was not removed"
            fi
            [[ "$ASK_ANSWER" =~ ^[Nn]$ ]] || keep_files=true
            if [[ "$MULTI_REMOVAL" == true ]] && [[ "$ASK_ANSWER" =~ ^[Aa]$ ]]; then
                KEEP_FILES_FOR_ALL=true
            fi
        fi
    fi

    # Changes a forced removal would discard, including ones git status does not show
    local unsaved
    unsaved=$(worktree_unsaved_state "$selected_path")
    if [[ -n "$unsaved" ]]; then
        warn "Worktree has unsaved state that removing it discards:"
        echo "$unsaved"
        ask discard-unsaved "Discard it and remove anyway? [y/N]: " "this worktree was not removed"
        [[ "$ASK_ANSWER" =~ ^[Yy]$ ]] || die "Aborted; this worktree was not removed."
    fi

    if [[ "$keep_files" == true ]]; then
        # Files that appeared or vanished while the prompts waited would not be kept;
        # list again right before the copy and stop if the set changed
        local relisted_file
        make_temp_file relisted_file || die "Failed to create a temp file"
        if ! list_worktree_keeper_files "$selected_path" "$main_worktree" > "$relisted_file"; then
            die "Could not list all unversioned files of $selected_path again (see above); nothing was removed"
        fi
        if ! cmp -s <(printf '%s\0' "${keepers[@]}" | sort -z) <(sort -z "$relisted_file"); then
            warn "The unversioned files changed while you were deciding (< gone, > new):"
            diff <(printf '%s\n' "${keepers[@]}" | sort) <(tr '\0' '\n' < "$relisted_file" | sort) | grep '^[<>]' || true
            rm -f -- "$relisted_file"
            die "Nothing was removed; run it again"
        fi
        rm -f -- "$relisted_file"
        remove_worktree_keeping_files "$selected_path" "$main_worktree" "${keepers[@]}"
        # The directory stays, so its Claude Code project entry stays too
    else
        # Under --yes-safe only: with no keepers, every untracked entry was classified
        # and shown above as deleted with the worktree; if that is all git can object
        # to and nothing unsaved was found (not merely confirmed), removing it is keep
        # mode with nothing to keep, so it is forced instead of stopping at the prompt.
        # Interactively the force-remove question is still asked.
        # The same holds for a worktree whose submodules were verified safe above:
        # git refuses it only because of them, and the force loses nothing.
        local only_discarded=false
        if [[ "$ASSUME_YES" == true ]] && [[ ${#keepers[@]} -eq 0 ]] && [[ -z "$unsaved" ]]; then
            if untracked_is_only_obstacle "$selected_path"; then
                only_discarded=true
            elif [[ "$submodules_verified" == true ]] && untracked_is_only_obstacle "$selected_path" submodules-ok; then
                only_discarded=true
            fi
        fi

        # Remove the worktree, offering --force if it has modifications
        if [[ "$DRY_RUN" == true ]]; then
            if [[ "$only_discarded" == true ]]; then
                mutate git worktree remove --force "$selected_path"
            else
                mutate git -c status.showUntrackedFiles=normal worktree remove "$selected_path"
            fi
        else
            if [[ "$only_discarded" == true ]]; then
                # A keeper written since the listing would be deleted by the force
                local relisted_none
                make_temp_file relisted_none || die "Failed to create a temp file"
                if ! list_worktree_keeper_files "$selected_path" "$main_worktree" > "$relisted_none"; then
                    rm -f -- "$relisted_none"
                    die "Could not list all unversioned files of $selected_path again (see above); nothing was removed"
                fi
                if [[ -s "$relisted_none" ]]; then
                    warn "Files worth keeping appeared since the listing:"
                    tr '\0' '\n' < "$relisted_none" | sed 's/^/  /'
                    rm -f -- "$relisted_none"
                    die "Nothing was removed; run it again"
                fi
                rm -f -- "$relisted_none"
            fi

            # Re-check right before the removal: the prompts above may have waited a while
            require_no_mounts "$selected_path" "remove $selected_path"
            if [[ "$only_discarded" == true ]]; then
                git worktree remove --force "$selected_path"
            # Pinned: with status.showUntrackedFiles=no git would delete untracked files
            # in a plain removal instead of refusing
            elif ! remove_error=$(git -c status.showUntrackedFiles=normal worktree remove "$selected_path" 2>&1); then
                warn "git worktree remove refused: ${remove_error}"
                if [[ "$submodules_verified" == true ]]; then
                    echo "submodules verified safe:"
                    echo "$SUBMODULE_REPORT"
                fi
                ask force-remove "Force remove? [y/N]: " "this worktree was not removed"
                if [[ "$ASK_ANSWER" =~ ^[Yy]$ ]]; then
                    # git worktree remove --force does not stop at mount points
                    require_no_mounts "$selected_path" "force-remove $selected_path"
                    git worktree remove --force "$selected_path"
                else
                    die "Aborted."
                fi
            fi
        fi

        if [[ "$DRY_RUN" == false ]]; then
            print_green "Worktree removed successfully."

            # Drop the worktree's Claude Code per-directory project entry
            remove_claude_project_entry "$selected_path"
        fi
    fi

    # Optionally delete the branch if it exists (never the main branch itself)
    if [[ "$selected_branch" != "detached" ]] && ! is_main_branch "$selected_branch"; then
        local main_branch
        main_branch=$(get_main_branch)

        # Merged into main by git history, or through a merged MR/PR (see branch_merge_verdict)
        branch_merge_verdict "$selected_branch" "$main_branch"
        if [[ "$BRANCH_VERDICT" == git ]]; then
            mutate git branch -d "$selected_branch"
            [[ "$DRY_RUN" == true ]] || print_green "Branch '$selected_branch' deleted (was merged into $main_branch)."
        elif [[ "$BRANCH_VERDICT" == mr ]]; then
            # Squash and rebase merges leave the branch unmerged for git; the merged
            # MR/PR carried every commit the branch has, so -D loses nothing
            mutate git branch -D "$selected_branch"
            [[ "$DRY_RUN" == true ]] || print_green "Branch '$selected_branch' deleted (${BRANCH_VERDICT_REF} into $main_branch is merged and the branch has no commit beyond it)."
        else
            # Ask for unmerged branches; --force never deletes one
            [[ "$BRANCH_VERDICT" != open-mr ]] || warn "Branch '$selected_branch' still has open ${BRANCH_VERDICT_REF}"
            if [[ "$FORCE_UNMERGED" == true ]]; then
                echo "Kept unmerged branch '$selected_branch' (--force); delete it with: git branch -D $(printf '%q' "$selected_branch")"
                return 0
            fi
            echo ""
            ask delete-unmerged-branch "Also delete unmerged branch '$selected_branch'? [y/N]: " "the worktree was already removed"
            if [[ "$ASK_ANSWER" =~ ^[Yy]$ ]]; then
                mutate git branch -D "$selected_branch"
                [[ "$DRY_RUN" == true ]] || print_green "Branch '$selected_branch' deleted."
            else
                echo "Kept unmerged branch '$selected_branch'; delete it with: git branch -D $(printf '%q' "$selected_branch")"
            fi
        fi
    fi
}

# Parse a selection like "3 7 12-40" (spaces or commas) into unique 0-based
# indexes in the given order. Every token is validated before anything is
# printed, so one bad token rejects the whole selection.
# Usage: parse_selection <selection> <count>
parse_selection() {
    local selection="$1"
    local count="$2"
    local -a tokens=()
    read -ra tokens <<< "${selection//,/ }"
    [[ ${#tokens[@]} -gt 0 ]] || die "Empty selection"

    local -A seen=()
    local -a indexes=()
    local token from to n
    for token in "${tokens[@]}"; do
        if [[ "$token" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            from="${BASH_REMATCH[1]}"
            to="${BASH_REMATCH[2]}"
        elif [[ "$token" =~ ^[0-9]+$ ]]; then
            from="$token"
            to="$token"
        else
            die "Invalid selection: $token"
        fi
        # Strip leading zeros and reject numbers longer than the count before any
        # arithmetic, which would wrap a 20-digit number around to a valid index
        from="${from#"${from%%[!0]*}"}"
        to="${to#"${to%%[!0]*}"}"
        if [[ -z "$from" || -z "$to" || ${#from} -gt ${#count} || ${#to} -gt ${#count} ]]; then
            die "Selection out of range: $token (1-${count})"
        fi
        if (( from < 1 || to > count || from > to )); then
            die "Selection out of range: $token (1-${count})"
        fi
        for (( n = from; n <= to; n++ )); do
            if [[ -z "${seen[$n]:-}" ]]; then
                seen[$n]=1
                indexes+=($((n - 1)))
            fi
        done
    done

    printf '%s\n' "${indexes[@]}"
}

# Find and remove orphaned directories in the worktrees directory
# These are leftover dirs that git worktree no longer tracks
# Checks both legacy (<project>-worktrees) and new (<project>/.worktrees) locations
# Usage: cleanup_orphaned_dirs <main_worktree_path>
cleanup_orphaned_dirs() {
    local main_worktree="$1"
    local legacy_dir new_dir
    legacy_dir=$(get_legacy_worktrees_dir "$main_worktree")
    new_dir="${main_worktree}/.worktrees"

    # Collect all worktrees dirs that exist
    local -a worktrees_dirs=()
    [[ -d "$legacy_dir" ]] && worktrees_dirs+=("$legacy_dir")
    [[ -d "$new_dir" ]] && worktrees_dirs+=("$new_dir")

    # No worktrees directories - nothing to clean
    [[ ${#worktrees_dirs[@]} -gt 0 ]] || return 0

    # Collect known worktree paths from git, resolved, so a symlinked worktrees dir
    # (git stores the real path) does not make every live worktree look orphaned
    local -a known_paths=()
    while IFS= read -r line; do
        if [[ "$line" =~ ^worktree\ (.+)$ ]]; then
            known_paths+=("${BASH_REMATCH[1]}")
        fi
    done < <(git worktree list --porcelain)
    local -a known_resolved=()
    mapfile -d '' -t known_resolved < <(realpath -z -m -- "${known_paths[@]}")
    [[ ${#known_resolved[@]} -eq ${#known_paths[@]} ]] || die "Failed to resolve the registered worktree paths"

    # Check each directory in all worktrees dirs
    local -a orphaned=()
    local -a unregistered=()
    local archived_count=0
    local dir wt_dir dir_resolved
    for wt_dir in "${worktrees_dirs[@]}"; do
    for dir in "$wt_dir"/*/; do
        [[ -d "$dir" ]] || continue
        dir="${dir%/}"  # strip trailing slash
        [[ ! -L "$dir" ]] || continue  # never follow a symlink out of the worktrees dir

        # Removed worktrees whose unversioned files were kept in place
        if [[ -f "${dir}/${WORKTREE_ARCHIVED_MARKER}" ]]; then
            archived_count=$((archived_count + 1))
            continue
        fi

        dir_resolved=$(realpath -e -- "$dir") || continue
        local is_known=false
        local known
        for known in "${known_resolved[@]}"; do
            if [[ "$dir_resolved" == "$known" ]]; then
                is_known=true
                break
            fi
        done

        if [[ "$is_known" == false ]]; then
            # A dir with .git is a worktree git lost track of, never an orphan to delete
            if [[ -e "${dir}/.git" || -L "${dir}/.git" ]]; then
                unregistered+=("$dir")
            else
                orphaned+=("$dir")
            fi
        fi
    done
    done

    if [[ ${#unregistered[@]} -gt 0 ]]; then
        warn "${#unregistered[@]} worktree directories have .git but are not registered (try git worktree repair), left alone:"
        for dir in "${unregistered[@]}"; do
            echo "  $dir" >&2
        done
    fi

    if [[ "$archived_count" -gt 0 ]]; then
        print_dim "${archived_count} archived worktree dirs kept (removed worktrees with their unversioned files, see ${WORKTREE_ARCHIVED_MARKER})"
    fi

    # Temp dirs of an interrupted keep or restore hold the only copy of some files
    local -a leftover_temps=()
    for wt_dir in "${worktrees_dirs[@]}"; do
        for dir in "$wt_dir"/.worktree-keep.* "$wt_dir"/.worktree-restore.*; do
            [[ -d "$dir" && ! -L "$dir" ]] && leftover_temps+=("$dir") || true
        done
    done
    if [[ ${#leftover_temps[@]} -gt 0 ]]; then
        warn "${#leftover_temps[@]} temp dirs left by an interrupted keep or restore, they may hold the only copy of kept files (never deleted automatically):"
        for dir in "${leftover_temps[@]}"; do
            echo "  $dir" >&2
        done
    fi

    [[ ${#orphaned[@]} -gt 0 ]] || return 0

    print_yellow "Found ${#orphaned[@]} orphaned worktree directories (not tracked by git):"
    echo ""
    for dir in "${orphaned[@]}"; do
        echo "  ${dir}/"
    done
    echo ""
    ask remove-orphans "Remove all orphaned directories? [y/N]: " "nothing was removed"
    if [[ ! "$ASK_ANSWER" =~ ^[Yy]$ ]]; then
        echo "Skipped ${#orphaned[@]} orphaned directories."
    else
        for dir in "${orphaned[@]}"; do
            safe_rm_rf "$dir" "$(dirname "$dir")" "$main_worktree" "${worktrees_dirs[@]}"
            if [[ "$DRY_RUN" == false ]]; then
                remove_claude_project_entry "$dir"
                print_green "Removed: $(basename "$dir")/"
            fi
        done
        echo ""
    fi
}

main() {
    local force_interactive=false
    local list_only=false
    local show_signals=true

    # Handle flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_help
                exit 0
                ;;
            --interactive|-i)
                force_interactive=true
                shift
                ;;
            --list|-l)
                list_only=true
                shift
                ;;
            --no-signals)
                show_signals=false
                shift
                ;;
            --dry-run|-n)
                DRY_RUN=true
                shift
                ;;
            --yes-safe)
                ASSUME_YES=true
                shift
                ;;
            --force)
                FORCE_UNMERGED=true
                shift
                ;;
            *)
                die "Unknown option: $1"
                ;;
        esac
    done

    require_git_repo

    local main_worktree
    main_worktree=$(get_main_repo_root)

    local current_worktree
    current_worktree=$(git rev-parse --show-toplevel)

    # Run from inside a linked worktree (and not -i/-l): clean up that worktree
    local current_mode=false
    if [[ "$current_worktree" != "$main_worktree" ]] && [[ "$force_interactive" == false ]] && [[ "$list_only" == false ]]; then
        current_mode=true
    fi

    # Run from inside an already archived worktree dir (no .git, so git resolved the
    # main checkout around it). As a git alias it runs from the top level and
    # GIT_PREFIX holds the directory it was invoked in; run directly, that is $PWD
    local archived_dir=""
    if [[ "$current_worktree" == "$main_worktree" ]]; then
        local probe="$PWD"
        [[ -z "${GIT_PREFIX:-}" ]] || probe="${main_worktree}/${GIT_PREFIX%/}"
        while [[ "$probe" == "${main_worktree}/"* ]]; do
            if [[ -f "${probe}/${WORKTREE_ARCHIVED_MARKER}" ]]; then
                archived_dir="$probe"
                break
            fi
            probe=$(dirname -- "$probe")
        done
    fi

    # --yes-safe only ever cleans up the worktree it runs in, never a selection: list
    # numbers shift when worktrees are created between runs
    if [[ "$ASSUME_YES" == true ]]; then
        [[ "$force_interactive" == false ]] || die "--yes-safe cannot be combined with -i; it only cleans up the current worktree"
        [[ "$list_only" == false ]] || die "--yes-safe cannot be combined with --list"
        [[ -z "$archived_dir" ]] || die "${archived_dir} is an archived worktree (see ${WORKTREE_ARCHIVED_MARKER}), nothing to remove"
        [[ "$current_worktree" != "$main_worktree" ]] || die "--yes-safe only works inside a linked worktree, this is the main repository"
    fi
    if [[ -n "$archived_dir" ]]; then
        print_dim "${archived_dir} is an archived worktree (see ${WORKTREE_ARCHIVED_MARKER}), nothing to remove there; showing all worktrees of the repository"
    fi
    if [[ "$FORCE_UNMERGED" == true ]] && [[ "$current_mode" == false ]]; then
        die "--force only applies when cleaning up the current worktree from inside it"
    fi

    # The current worktree's branch must be merged before anything is touched
    local current_branch=""
    if [[ "$current_mode" == true ]]; then
        # The plain branch name from refs/heads (also mid-rebase or mid-bisect), or
        # "detached"; never heads/<name> (tag of the same name) or "detached HEAD"
        current_branch=$(worktree_branch_name "$current_worktree")

        echo ""
        local info
        if [[ "$current_branch" != "detached" ]]; then
            info=$(get_worktree_branch_info "$current_branch")
        else
            info="${COLOR_YELLOW}(detached HEAD)${COLOR_RESET}"
        fi

        echo -e "Current worktree: $info"
        echo -e "  ${COLOR_BOLD}${current_worktree}${COLOR_RESET}"
        show_branch_mr_status "$current_branch"
        require_merged_or_force "$current_branch"
        check_recent_session_activity "$current_worktree"
        echo ""
    fi

    # --list is strictly read-only: no pruning, no orphan cleanup, no prompts
    if [[ "$list_only" == false ]]; then
        # Prune stale worktree references (e.g. manually deleted directories)
        if [[ "$DRY_RUN" == true ]]; then
            git worktree prune --dry-run --verbose
        else
            git worktree prune
        fi

        # Clean up orphaned worktree directories (not tracked by git worktree list)
        cleanup_orphaned_dirs "$main_worktree"
    fi

    if [[ "$current_mode" == true ]]; then
        ask remove-current "Remove this worktree? [Y/n]: " "this worktree was not removed"

        if [[ ! "$ASK_ANSWER" =~ ^[Nn]$ ]]; then
            echo ""
            remove_worktree "$current_worktree" "$current_branch"
        fi
        exit 0
    fi

    # Collect worktrees (excluding main)
    local -a worktree_paths=()
    local -a worktree_branches=()

    local current_path=""
    local skip_current=false

    while IFS= read -r line; do
        # Parse worktree list --porcelain output
        if [[ "$line" =~ ^worktree\ (.+)$ ]]; then
            current_path="${BASH_REMATCH[1]}"
            # Skip main worktree
            if [[ "$current_path" == "$main_worktree" ]]; then
                skip_current=true
            else
                skip_current=false
                worktree_paths+=("$current_path")
            fi
        elif [[ "$line" =~ ^branch\ refs/heads/(.+)$ ]]; then
            if [[ "$skip_current" == false ]]; then
                local branch="${BASH_REMATCH[1]}"
                worktree_branches+=("$branch")
            fi
        elif [[ "$line" =~ ^HEAD\ [0-9a-f]+$ ]] && [[ "$skip_current" == false ]] && [[ -z "${worktree_branches[${#worktree_paths[@]}-1]:-}" ]]; then
            # Detached HEAD - no branch line will follow, add placeholder
            :
        elif [[ -z "$line" ]]; then
            # Empty line separates worktree entries
            # If we added a path but no branch yet, it's detached
            if [[ "$skip_current" == false ]] && [[ ${#worktree_paths[@]} -gt ${#worktree_branches[@]} ]]; then
                worktree_branches+=("detached")
            fi
        fi
    done < <(git worktree list --porcelain)

    # Handle last entry if no trailing newline
    if [[ ${#worktree_paths[@]} -gt ${#worktree_branches[@]} ]]; then
        worktree_branches+=("detached")
    fi

    # Check if we have any worktrees to clean up
    if [[ ${#worktree_paths[@]} -eq 0 ]]; then
        echo "No worktrees to clean up (only the main repository exists)."
        exit 0
    fi

    # Precompute mainline commits for bulk merged-with-changes detection
    local main_branch
    main_branch=$(get_main_branch)
    local _mainline_file
    make_temp_file _mainline_file || die "Failed to create a temp file"
    get_mainline_commits "$main_branch" > "$_mainline_file"

    # Signals: unversioned keeper files (scanned in parallel) and Claude sessions per path
    local -A keep_counts=() keep_newest=() keep_discarded=()
    if [[ "$show_signals" == true ]]; then
        local _session_index_file
        make_temp_file _session_index_file || die "Failed to create a temp file"
        build_claude_session_index > "$_session_index_file"
        local summary_path summary_count summary_newest summary_discarded
        while IFS=$'\t' read -r summary_path summary_count summary_newest summary_discarded; do
            keep_counts["$summary_path"]="$summary_count"
            keep_newest["$summary_path"]="$summary_newest"
            keep_discarded["$summary_path"]="$summary_discarded"
        done < <(compute_keeper_summaries "$main_worktree" "${worktree_paths[@]}")
    fi

    # Build display list
    echo ""
    print_bold "Worktrees:"
    echo ""

    for i in "${!worktree_paths[@]}"; do
        local path="${worktree_paths[$i]}"
        local branch="${worktree_branches[$i]:-detached}"
        local num=$((i + 1))

        local status_tag=""
        if [[ "$branch" != "detached" ]]; then
            if is_branch_merged_with_changes "$branch" "$main_branch" "$_mainline_file"; then
                status_tag="${COLOR_PURPLE}[merged]${COLOR_RESET} "
            elif is_branch_no_changes "$branch" "$main_branch"; then
                status_tag="${COLOR_PURPLE}[no changes]${COLOR_RESET} "
            fi
        fi

        local info
        if [[ "$branch" != "detached" ]]; then
            info=$(get_worktree_branch_info "$branch")
        else
            info="${COLOR_YELLOW}(detached HEAD)${COLOR_RESET}"
        fi

        printf "  %2d) %b%s\n" "$num" "$status_tag" "$info"
        printf "      ${COLOR_BOLD}%s${COLOR_RESET}\n" "$path"
        if [[ "$show_signals" == true ]]; then
            local session_count session_newest
            read -r session_count session_newest < <(claude_sessions_for_path "$_session_index_file" "$path")
            printf "      %s\n" "$(format_worktree_signals "${keep_counts[$path]:-?}" "${keep_newest[$path]:-0}" "$session_count" "$session_newest" "${keep_discarded[$path]:-0}")"
        fi
        echo ""
    done

    [[ "$list_only" == false ]] || exit 0

    # Prompt for selection
    local selection
    ask selection "Enter numbers to remove, e.g. 3 7 12-40 (Ctrl+C to cancel): " "nothing was removed"
    selection="$ASK_ANSWER"

    # Validate the whole selection before removing anything
    local parsed
    parsed=$(parse_selection "$selection" "${#worktree_paths[@]}")
    local -a selected_indexes=()
    mapfile -t selected_indexes <<< "$parsed"

    local index
    if [[ ${#selected_indexes[@]} -gt 1 ]]; then
        echo ""
        print_bold "Selected ${#selected_indexes[@]} worktrees:"
        for index in "${selected_indexes[@]}"; do
            printf "  %2d) %s\n" $((index + 1)) "${worktree_paths[$index]}"
        done
        echo ""
        ask confirm-selection "Remove these ${#selected_indexes[@]} worktrees? [y/N]: " "nothing was removed"
        [[ "$ASK_ANSWER" =~ ^[Yy]$ ]] || die "Aborted."
        MULTI_REMOVAL=true
    fi

    # Any failure stops the run (set -e), leaving the remaining worktrees untouched
    for index in "${selected_indexes[@]}"; do
        echo ""
        remove_worktree "${worktree_paths[$index]}" "${worktree_branches[$index]:-detached}"
    done
}

main "$@"
