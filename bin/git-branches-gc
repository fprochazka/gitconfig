#!/usr/bin/env bash
#
# git-branches-gc - List and optionally delete stale local branches
#
# Usage: git branches-gc [--merged] [--gone] [--drop]
#
# Lists branches that are either merged into main or have gone remotes.
# Excludes current branch, main branches, branches in worktrees, and merged
# branches ahead of their remote copy.
#

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/common.sh"

show_help() {
    cat << 'EOF'
Usage: git branches-gc [--merged] [--gone] [--drop]

List and optionally delete stale local branches.

Filters:
    --merged    Include branches merged into main
    --gone      Include branches whose upstream is gone

    If neither --merged nor --gone is specified, both are included.

Actions:
    --drop      Delete the listed branches (merged with -d, gone with -D); a branch that cannot be
                deleted is reported and skipped, and the command exits 1 at the end

Excludes:
  - Current branch (marked with *)
  - Main branches (master, main, develop)
  - Branches currently checked out in worktrees

Examples:
    git branches-gc                    # List all stale branches
    git branches-gc --merged           # List only merged branches
    git branches-gc --gone             # List only gone branches
    git branches-gc --drop             # Delete all stale branches
    git branches-gc --merged --drop    # Delete only merged branches
EOF
}

# Get merged branches (excluding main, develop, and branches checked out in any worktree, the current one included)
# Prints "<branch>:" for a branch to delete and "<branch>:<reason>" for one to keep. <branch> is refname:short,
# the name the branch was always listed and deleted under; ":" cannot occur in a ref name.
#
# A branch ahead of its remote copy is kept even when merged: those commits are unpushed work. The remote copy is the
# push destination when it exists (push.default=current gives origin/<b> also for a branch whose upstream is
# origin/master), otherwise the upstream, the same rule as branch_merge_verdict in git-worktree-cleanup.
# The :track atoms say "[gone]" for a missing ref and "[ahead N]" or "[ahead N, behind M]" for one it is ahead of.
get_merged_branches() {
    local main_branch="$1"

    # merge-base --is-ancestor against a missing main branch fails for every branch, so nothing is merged
    git rev-parse --quiet --verify "${main_branch}^{commit}" >/dev/null || return 0

    local refs
    if ! refs=$(git for-each-ref --merged "$main_branch" --format='%(if)%(worktreepath)%(then)%(else)%(refname:short):%(push):%(push:track):%(upstream):%(upstream:track)%(end)' refs/heads/); then
        warn "Cannot compare merged branches with their remote copies, keeping all of them"
        return 0
    fi

    local branch push_ref push_track upstream_ref upstream_track compare_ref compare_track
    while IFS=: read -r branch push_ref push_track upstream_ref upstream_track; do
        [[ -z "$branch" ]] && continue

        # Skip main/develop branches
        [[ "$branch" =~ ^(master|main|develop)$ ]] && continue

        compare_ref=""
        compare_track=""
        if [[ "$push_ref" == refs/remotes/* ]] && [[ "$push_track" != "[gone]" ]]; then
            compare_ref="$push_ref"
            compare_track="$push_track"
        elif [[ "$upstream_ref" == refs/remotes/* ]] && [[ "$upstream_track" != "[gone]" ]]; then
            compare_ref="$upstream_ref"
            compare_track="$upstream_track"
        fi

        if [[ "$compare_track" =~ ahead\ ([0-9]+) ]]; then
            echo "${branch}:skipped (ahead of ${compare_ref#refs/remotes/} by ${BASH_REMATCH[1]})"
        else
            echo "${branch}:"
        fi
    done <<< "$refs"
}

# Get gone branches (excluding branches checked out in any worktree, the current one included)
# Prints the name git branch shows, and skips every name starting with master, main or develop in any case,
# the way the git branch -vv | grep filter this replaced did
get_gone_branches() {
    git for-each-ref --format='%(if:equals=[gone])%(upstream:track)%(then)%(if)%(worktreepath)%(then)%(else)%(refname:lstrip=2)%(end)%(end)' refs/heads/ | while read -r branch; do
        [[ -z "$branch" ]] && continue

        # Skip main/develop branches
        [[ "${branch,,}" =~ ^(master|main|develop) ]] && continue

        echo "$branch"
    done
}

main() {
    local include_merged=false
    local include_gone=false
    local do_drop=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_help
                exit 0
                ;;
            --merged)
                include_merged=true
                shift
                ;;
            --gone)
                include_gone=true
                shift
                ;;
            --drop)
                do_drop=true
                shift
                ;;
            *)
                die "Unknown option: $1"
                ;;
        esac
    done

    # If neither filter specified, include both
    if [[ "$include_merged" == false ]] && [[ "$include_gone" == false ]]; then
        include_merged=true
        include_gone=true
    fi

    require_git_repo

    local main_branch
    main_branch=$(get_main_branch)

    # Collect branches to process
    local -a merged_branches=()
    local -a gone_branches=()

    # Merged branches kept because they are ahead of their remote copy, with the reason
    local -A skip_reasons=()
    local reason

    if [[ "$include_merged" == true ]]; then
        while IFS=: read -r branch reason; do
            [[ -z "$branch" ]] && continue
            merged_branches+=("$branch")
            [[ -n "$reason" ]] && skip_reasons[$branch]="$reason"
        done < <(get_merged_branches "$main_branch")
    fi

    if [[ "$include_gone" == true ]]; then
        # Merged branches, kept ones included, are never deleted again as gone
        local -A merged_set=()
        for branch in "${merged_branches[@]+"${merged_branches[@]}"}"; do
            merged_set[$branch]=1
        done
        while IFS= read -r branch; do
            [[ -z "$branch" ]] && continue
            # Skip branches already in merged list to avoid double-deletion
            [[ -n "${merged_set[$branch]+set}" ]] || gone_branches+=("$branch")
        done < <(get_gone_branches)
    fi

    # Process merged branches
    if [[ "$include_merged" == true ]] && [[ "$do_drop" == true ]]; then
        echo "Removing cleanly merged branches."
    fi
    local failed=false
    for branch in "${merged_branches[@]+"${merged_branches[@]}"}"; do
        if [[ -n "${skip_reasons[$branch]+set}" ]]; then
            echo "${branch} ${skip_reasons[$branch]}"
        elif [[ "$do_drop" == true ]]; then
            if ! git branch -d "$branch"; then
                warn "Could not delete branch ${branch}, continuing"
                failed=true
            fi
        else
            echo "$branch"
        fi
    done

    # Process gone branches
    if [[ "$include_gone" == true ]] && [[ "$do_drop" == true ]]; then
        echo "Removing gone branches."
    fi
    for branch in "${gone_branches[@]+"${gone_branches[@]}"}"; do
        if [[ "$do_drop" == true ]]; then
            if ! git branch -D "$branch"; then
                warn "Could not delete branch ${branch}, continuing"
                failed=true
            fi
        else
            echo "$branch"
        fi
    done

    if [[ "$failed" == true ]]; then
        exit 1
    fi
}

main "$@"
